# --- Render (Node API) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
# Comma-separated browser origins, e.g. https://your-site.netlify.app
CORS_ORIGINS=
# Optional; Render sets PORT. Use 0.0.0.0 when BIND is required explicitly:
# BIND=0.0.0.0

# --- Netlify build (static site only; public API origin, not a secret) ---
# UNIFIT_API_BASE=https://your-service.onrender.com

# Optional: Gemini rollback (off by default on production)
# ENABLE_GEMINI_ROLLBACK_ROUTE=1
# GEMINI_API_KEY=
# GEMINI_MODEL=