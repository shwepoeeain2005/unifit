{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node maintenance/build-public.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/assistant/chat",
      "destination": "https://unifit-w3le.onrender.com/api/assistant/chat"
    }
  ],
  "functions": {
    "api/chat.py": {
      "includeFiles": "maintenance/{chat_server.py,chat_lookup.py,chat_model.py,unifit.sqlite}",
      "excludeFiles": "{assets/**,data/**,universities/**,dist/**,**/.env*}"
    }
  }
}
